# =============================================================================
# Career Navigator — environment template
# =============================================================================
# This file is a REFERENCE. It contains no secrets and is safe to commit.
#
# To set up your own environment:
#   1. Copy this file to backend/.env      ->  cp example.env backend/.env
#   2. Fill in the blanks below with your real values.
#   3. Never commit backend/.env — it is gitignored on purpose.
#
# Blank values are optional (features stay off until you supply a key/token).
# Values shown are safe local-dev defaults you can keep as-is.
# =============================================================================

# --- Core Django -------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=django-insecure-replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# --- Database (defaults to sqlite if blank) ----------------------------------
DATABASE_URL=

# --- Redis / Celery / Channels -----------------------------------------------
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNEL_LAYER=False
RUN_INGESTION_ASYNC=False

# --- Credentials vault encryption --------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-strong-secret

# --- AI provider -------------------------------------------------------------
# Hosted/SaaS deploy: AI_PROVIDER=nvidia (set NVIDIA_API_KEY).
# AI_PROVIDER=codex_cli is local-only — needs `codex login` on the machine.
AI_PROVIDER=nvidia
AI_FALLBACK_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_GUEST_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
GUEST_CHAT_MAX_TOKENS=200000
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_TOKENS=2048
CODEX_CLI_COMMAND=codex
CODEX_CLI_MODEL=
CODEX_CLI_SANDBOX=read-only
CODEX_CLI_TIMEOUT_SECONDS=120
CODEX_CLI_WORKDIR=

# --- Job sources: aggregator & ATS APIs (no scraping) ------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
JSEARCH_RAPIDAPI_KEY=
# Comma-separated ATS board tokens, e.g. "stripe,airbnb,figma"
GREENHOUSE_TOKENS=
LEVER_TOKENS=

# --- Job sources: portal automation (no-API, browser-driven) -----------------
# Off by default. To use: set PORTAL_SCRAPER_ENABLED=True and run
# `playwright install chromium` on the machine.
# Session cookies are the USER'S OWN session (never a shared scraping account):
# paste the value of the named auth cookie from a logged-in browser
# (DevTools -> Application -> Cookies), or supply per-user sessions via
# POST /api/v1/portals/<name>/session/. Cookie NAMES live in
# portals/registry.py and are best-effort — verify against the live site.
# Note: scraping LinkedIn / Glassdoor / Indeed may violate their Terms of Service.
PORTAL_SCRAPER_ENABLED=False
PORTAL_SCRAPER_HEADLESS=True
PORTAL_SCRAPER_MIN_DELAY_SECONDS=1.5
PORTAL_SCRAPER_MAX_RESULTS=25
LINKEDIN_SESSION_COOKIE=
NAUKRI_SESSION_COOKIE=
UNSTOP_SESSION_COOKIE=
YC_SESSION_COOKIE=
INSTAHYRE_SESSION_COOKIE=
WELLFOUND_SESSION_COOKIE=
SHINE_SESSION_COOKIE=
INDEED_SESSION_COOKIE=
TIMESJOBS_SESSION_COOKIE=
FOUNDIT_SESSION_COOKIE=
CUTSHORT_SESSION_COOKIE=
HIRECT_SESSION_COOKIE=
INTERNSHALA_SESSION_COOKIE=
GLASSDOOR_SESSION_COOKIE=

# --- Notifications -----------------------------------------------------------
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@career-navigator.local

# --- Google OAuth ------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
