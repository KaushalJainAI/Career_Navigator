VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000
# Google Identity Services client ID (used by the @react-oauth/google button).
# The same value must be set as GOOGLE_OAUTH_CLIENT_ID in the backend — the
# backend verifies the ID token's audience against it. No redirect URI needed:
# GIS returns the credential in a popup, no OAuth callback route.
VITE_GOOGLE_CLIENT_ID=
